# Dakota external connectors
# Copy this file to .env and fill only the providers actually used.

# Web/news
DAKOTA_WEB_EVIDENCE=1

# X API v2
X_BEARER_TOKEN=

# Reddit OAuth
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=Dakota/0.3 research prototype

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Example: vXX.X - set the current Meta Graph API version used by the account.
META_GRAPH_VERSION=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Investigation behaviour
# Set to 0 to debug without external web/social calls.
DAKOTA_WEB_EVIDENCE=1

# AI Provider Priority Order: gemini > mesh > grok > builtin
AI_PROVIDER_PRIORITY=gemini,mesh,grok,builtin

# 1. Google Gemini (Priority #1)
GEMINI_API_KEY=
DAKOTA_GEMINI_MODEL=gemini-3.8-flash

# 2. Mesh API Router (Priority #2 - https://app.meshapi.ai)
MESH_API_KEY=
MESH_MODEL=google/gemini-2.5-flash
MESH_BASE_URL=https://api.meshapi.ai/v1

# 3. xAI Grok (Priority #3 - https://x.ai)
# GROK_API_KEY=
# XAI_API_KEY=
# XAI_MODEL=grok-2-latest
# XAI_BASE_URL=https://api.x.ai/v1

# 4. Built-in Engine (Priority #4 - Native Grounded Forensic Synthesizer, 0% Hallucination)
# (Active automatically whenever higher tier providers fail or are unconfigured)
