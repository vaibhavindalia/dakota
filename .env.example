# Dakota external connectors
# Copy this file to .env and fill only the providers actually used.

# Web/news
DAKOTA_WEB_EVIDENCE=1

# X API v2
X_BEARER_TOKEN=

# Reddit OAuth
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=Dakota/0.3 research prototype

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Example: vXX.X - set the current Meta Graph API version used by the account.
META_GRAPH_VERSION=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Investigation behaviour
# Set to 0 to debug without external web/social calls.
DAKOTA_WEB_EVIDENCE=1
